# Supabase, from Project settings, API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres connection string, from Project settings, Database.
# Used only by the local setup script, never by the running application.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Optional. Without it the assistant, the alert parser and the playbooks fall
# back to their deterministic paths and the platform still works end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret required on the bank alert ingest webhook. Leave blank to allow
# unauthenticated posting while demonstrating.
COFX_WEBHOOK_SECRET=

# Shared secret for the scheduled jobs. Vercel sends it as a bearer token.
CRON_SECRET=

# Password issued to the seeded staff accounts by the setup script.
DEMO_PASSWORD=Wannerpart2026!

# Google and Microsoft sign in. Leave blank to keep those buttons hidden.
# Create the Google credentials at console.cloud.google.com, APIs and services,
# Credentials, Create credentials, OAuth client ID, Web application, using the
# redirect URI printed by scripts/enable-oauth.mjs. Then run that script.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# Optional, restricts Microsoft sign in to one tenant.
SUPABASE_AUTH_EXTERNAL_AZURE_URL=
